---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE_TITLE, SITE_DESCRIPTION, DEFAULT_LOCALE, HTML_LANG, MOODS, type Locale, type Mood } from '../consts';
import { t } from '../i18n/ui';
import LangSwitcher from '../components/LangSwitcher.astro';
import SlimeRipple from '../components/SlimeRipple.astro';
import AWaves from '../components/AWaves.astro';
import EmotionField from '../components/EmotionField.astro';
import CursorDot from '../components/CursorDot.astro';
import I18nScript from '../components/I18nScript.astro';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  mood?: Mood;
}

const { title, description = SITE_DESCRIPTION, locale = DEFAULT_LOCALE, mood = 'calm' } = Astro.props;
const strings = t(locale);
const siteTitle = strings['site.title'];
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const homeHref = locale === DEFAULT_LOCALE ? '/' : `/${locale}/`;

/* 页面 mood → 情绪色阶锚点（data-emo）与初始 --goo-color */
const EMO_INDEX: Record<string, number> = {
  calm: 1, focus: 2, tense: 3, excited: 4, overload: 5,
};
const EMO_RGB: Record<string, string> = {
  calm: '94, 234, 212', focus: '103, 232, 249', tense: '167, 139, 250',
  excited: '244, 114, 182', overload: '248, 113, 113',
};
const emoIndex = EMO_INDEX[mood] ?? 1;
const emoRgb = EMO_RGB[mood] ?? EMO_RGB.calm;
---
<!doctype html>
<html lang={HTML_LANG[locale]} data-emo={emoIndex} style={`--mood: ${MOODS[mood].color}; --goo-color: ${emoRgb}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    {/* 客户端路由：页面切换不再整页刷新，配合 transition:persist 保持光标与背景层 */}
    <ClientRouter />
  </head>
  <body>
    <AWaves transition:persist />
    <header class="site-header">
      <div class="header-inner">
        <a class="site-title" href={homeHref} data-i18n="site.title">{siteTitle}</a>
        <nav class="site-nav">
          <a href="/blog/" data-i18n="nav.blog">{strings['nav.blog']}</a>
          <a href="/archive/" data-i18n="nav.archive">{strings['nav.archive']}</a>
          <LangSwitcher current={locale} />
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span>© 2026 LIAN / HEYUCHICK</span>
        <span data-i18n="footer.note">{strings['footer.note']}</span>
      </div>
    </footer>
    <SlimeRipple transition:persist />
    <EmotionField transition:persist />
    <CursorDot />

    {/* 客户端 i18n：共享组件，主站可复用 */}
    <I18nScript />

    {/* 代码块复制：事件委托一次绑定永久有效；is:inline 脚本每次导航后重跑，由 window 旗标防重 */}
    <script is:inline>
      (function () {
        if (window.__copyDelegated) return;
        window.__copyDelegated = true;
        document.addEventListener('click', function (e) {
          var btn = e.target && e.target.closest ? e.target.closest('.code-copy') : null;
          if (!btn) return;
          var block = btn.closest('.code-block');
          var pre = block && block.querySelector('pre');
          if (!pre) return;
          var done = function () {
            btn.classList.add('copied');
            btn.textContent = 'copied';
            setTimeout(function () {
              btn.classList.remove('copied');
              btn.textContent = 'copy';
            }, 1500);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(pre.innerText).then(done);
          } else {
            // 降级：非安全上下文（http）等场景
            var ta = document.createElement('textarea');
            ta.value = pre.innerText;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            ta.remove();
            done();
          }
        });
      })();
    </script>
  </body>
</html>

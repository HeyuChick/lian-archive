---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE_DESCRIPTION, DEFAULT_LOCALE, HTML_LANG, MOODS, type Locale, type Mood } from '../consts';
import { t } from '../i18n/ui';
import LangSwitcher from '../components/LangSwitcher.astro';
import SlimeRipple from '../components/SlimeRipple.astro';
import AWaves from '../components/AWaves.astro';
import EmotionField from '../components/EmotionField.astro';
import CursorDot from '../components/CursorDot.astro';
import I18nScript from '../components/I18nScript.astro';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  mood?: Mood;
}

const { title, description = SITE_DESCRIPTION, locale = DEFAULT_LOCALE, mood = 'calm' } = Astro.props;
const strings = t(locale);
const siteTitle = strings['site.title'];
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const homeHref = locale === DEFAULT_LOCALE ? '/' : `/${locale}/`;

/* 页面 mood → 情绪色阶锚点（data-emo）与初始 --goo-color */
const EMO_INDEX: Record<string, number> = {
  calm: 1, focus: 2, warm: 2, tense: 3, gloom: 3, excited: 4, joy: 4, overload: 5,
};
const EMO_RGB: Record<string, string> = {
  calm: '94, 234, 212', focus: '103, 232, 249', tense: '167, 139, 250',
  warm: '103, 232, 249', gloom: '167, 139, 250', excited: '244, 114, 182',
  joy: '244, 114, 182', overload: '248, 113, 113',
};
const emoIndex = EMO_INDEX[mood] ?? 1;
const emoRgb = EMO_RGB[mood] ?? EMO_RGB.calm;
---
<!doctype html>
<html lang={HTML_LANG[locale]} data-emo={emoIndex} style={`--mood: ${MOODS[mood].color}; --goo-color: ${emoRgb}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <AWaves />
    <header class="site-header" transition:name="header">
      <div class="header-inner">
        <a class="site-title" href={homeHref} data-i18n="site.title">{siteTitle}</a>
        <nav class="site-nav">
          <a href="/blog/" data-i18n="nav.blog">{strings['nav.blog']}</a>
          <a href="/archive/" data-i18n="nav.archive">{strings['nav.archive']}</a>
          <LangSwitcher current={locale} />
        </nav>
      </div>
    </header>
    <main transition:name="content">
      <slot />
    </main>
    <footer class="site-footer" transition:name="footer">
      <div class="footer-inner">
        <span>© 2026 LIAN / HEYUCHICK</span>
        <span data-i18n="footer.note">{strings['footer.note']}</span>
      </div>
    </footer>
    <SlimeRipple />
    <EmotionField />
    <CursorDot />

    <I18nScript />

    <script>
      document.addEventListener('click', (e) => {
        const target = e.target as Element | null;
        const btn = target?.closest<HTMLButtonElement>('.code-copy');
        const pre = btn?.closest('.code-block')?.querySelector('pre');
        if (!btn || !pre) return;
        const done = () => {
          btn.classList.add('copied');
          btn.textContent = 'copied';
          setTimeout(() => {
            btn.classList.remove('copied');
            btn.textContent = 'copy';
          }, 1500);
        };
        if (navigator.clipboard?.writeText) {
          navigator.clipboard.writeText(pre.innerText).then(done);
        } else {
          const ta = document.createElement('textarea');
          ta.value = pre.innerText;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
          done();
        }
      });
    </script>
  </body>
</html>

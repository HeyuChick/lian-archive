---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, DEFAULT_LOCALE, HTML_LANG, MOODS, type Locale, type Mood } from '../consts';
import { t, ui } from '../i18n/ui';
import LangSwitcher from '../components/LangSwitcher.astro';
import SlimeRipple from '../components/SlimeRipple.astro';
import AWaves from '../components/AWaves.astro';
import EmotionField from '../components/EmotionField.astro';
import CursorDot from '../components/CursorDot.astro';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  mood?: Mood;
}

const { title, description = SITE_DESCRIPTION, locale = DEFAULT_LOCALE, mood = 'calm' } = Astro.props;
const strings = t(locale);
const siteTitle = strings['site.title'];
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const homeHref = locale === DEFAULT_LOCALE ? '/' : `/${locale}/`;

/* 页面 mood → 情绪色阶锚点（data-emo）与初始 --goo-color */
const EMO_INDEX: Record<string, number> = {
  calm: 1, focus: 2, tense: 3, excited: 4, overload: 5,
};
const EMO_RGB: Record<string, string> = {
  calm: '94, 234, 212', focus: '103, 232, 249', tense: '167, 139, 250',
  excited: '244, 114, 182', overload: '248, 113, 113',
};
const emoIndex = EMO_INDEX[mood] ?? 1;
const emoRgb = EMO_RGB[mood] ?? EMO_RGB.calm;
---
<!doctype html>
<html lang={HTML_LANG[locale]} data-emo={emoIndex} style={`--mood: ${MOODS[mood].color}; --goo-color: ${emoRgb}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <AWaves />
    <header class="site-header">
      <div class="header-inner">
        <a class="site-title" href={homeHref} data-i18n="site.title">{siteTitle}</a>
        <nav class="site-nav">
          <a href="/blog/" data-i18n="nav.blog">{strings['nav.blog']}</a>
          <a href="/archive/" data-i18n="nav.archive">{strings['nav.archive']}</a>
          <LangSwitcher current={locale} />
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span>© 2026 LIAN / HEYUCHICK</span>
        <span data-i18n="footer.note">{strings['footer.note']}</span>
      </div>
    </footer>
    <SlimeRipple />
    <EmotionField />
    <CursorDot />

    {/* 客户端 i18n：读取 localStorage 持久化语言选择，全站 UI 即时切换 */}
    <script is:inline define:vars={{ uiDict: ui }}>
      (function () {
        var HTML_LANG = { zh: 'zh-CN', en: 'en', ja: 'ja' };
        var buttons = document.querySelectorAll('.lang-btn');

        function apply(lang) {
          var dict = uiDict[lang];
          if (!dict) return;
          document.documentElement.lang = HTML_LANG[lang] || lang;
          document.querySelectorAll('[data-i18n]').forEach(function (el) {
            var key = el.getAttribute('data-i18n');
            if (dict[key] !== undefined) el.textContent = dict[key];
          });
          buttons.forEach(function (b) {
            b.classList.toggle('is-active', b.getAttribute('data-lang') === lang);
          });
          localStorage.setItem('lian-lang', lang);
        }

        buttons.forEach(function (b) {
          b.addEventListener('click', function () {
            apply(b.getAttribute('data-lang'));
          });
        });

        var saved = localStorage.getItem('lian-lang');
        if (saved && uiDict[saved]) {
          apply(saved);
        } else {
          var nav = (navigator.language || '').toLowerCase();
          if (nav.indexOf('ja') === 0) apply('ja');
          else if (nav.indexOf('en') === 0) apply('en');
          else apply('zh');
        }
      })();
    </script>
  </body>
</html>

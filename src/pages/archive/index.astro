---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MOODS, DEFAULT_LOCALE } from '../../consts';
import { t } from '../../i18n/ui';
import { entryPath, entryTitle, groupBySection, isFolderIndex } from '../../lib/archive';

const strings = t(DEFAULT_LOCALE);

const entries = await getCollection(
  'archive',
  ({ data }) => (import.meta.env.PROD ? data.publish : true),
);
const visible = entries.filter((e) => !isFolderIndex(e));
const groups = groupBySection(visible);

const moodColor = (mood: string) =>
  (MOODS as Record<string, { color: string }>)[mood]?.color ?? 'rgb(94, 234, 212)';
---
<BaseLayout title="档案馆">
  <section>
    <header class="page-head">
      <p class="page-kicker" data-i18n="archive.kicker">{strings['archive.kicker']}</p>
      <h1 class="page-title" data-i18n="archive.title">{strings['archive.title']}</h1>
    </header>

    {visible.length === 0 ? (
      <p class="empty-state" data-i18n="archive.empty">{strings['archive.empty']}</p>
    ) : (
      groups.map(({ section, items }) => (
        <section class="folder-group">
          {section && <p class="folder-title">{section}</p>}
          <ul class="post-list">
            {items.map((entry) => (
              <li>
                <a
                  class="post-row"
                  href={`/archive/${entryPath(entry)}/`}
                  style={`--mood: ${moodColor(entry.data.mood)}`}
                >
                  <span class="post-copy">
                    <span class="post-title">{entryTitle(entry)}</span>
                    {entry.data.archive_summary && (
                      <span class="post-summary">{entry.data.archive_summary}</span>
                    )}
                  </span>
                  {entry.data.updated && (
                    <time class="post-date" datetime={entry.data.updated.toISOString()}>
                      {entry.data.updated.toLocaleDateString('zh-CN')}
                    </time>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    )}
  </section>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('archive', ({ data }) => data.publish)).sort(
  (a, b) => a.data.order - b.data.order,
);

/* 档案编号：DOC-01、DOC-02…… 按 order 顺序生成 */
const docNo = (n: number) => `DOC-${String(n + 1).padStart(2, '0')}`;
---
<BaseLayout title="样本档案">
  <header class="page-head">
    <p class="page-kicker" data-i18n="archive.kicker">ARCHIVE // SPECIMEN-08</p>
    <h1 class="page-title" data-i18n="archive.title">样本档案</h1>
  </header>
  {entries.length === 0 ? (
    <p class="empty-state" data-i18n="archive.empty">该分区档案尚未解密，请等待权限开放。</p>
  ) : (
    <ul class="post-list">
      {entries.map((entry, i) => (
        <li>
          <a class="post-row" href={`/archive/${entry.id}/`}>
            <span class="post-title">{entry.data.title}</span>
            <span class="post-doc">{docNo(i)}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MOODS, DEFAULT_LOCALE } from '../../consts';
import { t } from '../../i18n/ui';
import {
  entryPath,
  entryTitle,
  isFolderIndex,
  backlinksOf,
  type ArchiveEntry,
} from '../../lib/archive';

export async function getStaticPaths() {
  const entries = await getCollection(
    'archive',
    ({ data }) => (import.meta.env.PROD ? data.publish : true),
  );
  const visible = entries.filter((e) => !isFolderIndex(e));
  return visible.map((entry) => ({
    params: { slug: entryPath(entry) },
    props: { entry, all: visible },
  }));
}

interface Props {
  entry: ArchiveEntry;
  all: ArchiveEntry[];
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const strings = t(DEFAULT_LOCALE);

const title = entryTitle(entry);
const section = entry.data.archive_section;
const backlinks = backlinksOf(entry, all);
const mood = (entry.data.mood || 'calm') as any;
---
<BaseLayout title={title} mood={mood}>
  <article class="prose" style={`--mood: ${(MOODS as Record<string, { color: string }>)[entry.data.mood]?.color ?? 'rgb(94, 234, 212)'}`}>
    {section && (
      <p class="post-meta">
        <a href="/archive/" style="text-decoration:none;color:inherit">ARCHIVE</a>
        {' / ' + section}
      </p>
    )}
    <Content />

    {backlinks.length > 0 && (
      <section class="backlinks">
        <h2 data-i18n="archive.backlinks">{strings['archive.backlinks']}</h2>
        <ul>
          {backlinks.map((from) => (
            <li>
              <a href={`/archive/${entryPath(from)}/`}>{entryTitle(from)}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

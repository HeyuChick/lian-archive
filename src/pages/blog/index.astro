---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MOODS } from '../../consts';

const posts = (
  await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="研究员日志">
  <section class="prose">
    <h1>研究员日志</h1>
  </section>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`} style={`--mood: ${MOODS[post.data.mood].color}`}>
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('zh-CN')}
          </time>
          <span>{post.data.title}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

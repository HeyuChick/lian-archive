---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (
  await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

/* 日期统一为 YYYY/MM/DD，补零保持等长 */
const fmt = (d: Date) =>
  `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}`;
---
<BaseLayout title="研究员日志">
  <header class="page-head">
    <p class="page-kicker">FIELD NOTES // 研究记录</p>
    <h1 class="page-title">研究员日志</h1>
  </header>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a class="post-row" href={`/blog/${post.id}/`}>
          <span class="post-title">{post.data.title}</span>
          <time class="post-date" datetime={post.data.date.toISOString()}>
            {fmt(post.data.date)}
          </time>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

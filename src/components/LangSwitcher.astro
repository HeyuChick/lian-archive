---
// 语言切换：客户端按钮，写入 localStorage 并即时应用，全站 UI 保持所选语言
---
<div class="lang-switcher" role="group" aria-label="Language / 语言 / 言語">
  <button class="lang-btn" type="button" data-lang="zh">中</button>
  <button class="lang-btn" type="button" data-lang="en">EN</button>
  <button class="lang-btn" type="button" data-lang="ja">日</button>
</div>

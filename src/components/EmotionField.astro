<script>
  const EMOS = [
    '255, 255, 255',
    '94, 234, 212',
    '103, 232, 249',
    '167, 139, 250',
    '244, 114, 182',
    '248, 113, 113',
  ];
  const root = document.documentElement;
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  let anchor = 1;
  let energy = 0;
  let current = -1;
  let timer = 0;
  let lastMove = 0;

  function paint() {
    const stage = Math.min(5, anchor + Math.round(energy));
    if (stage === current) return;
    current = stage;
    root.style.setProperty('--goo-color', EMOS[stage]);
    root.style.setProperty('--waves-opacity', String(0.08 + stage * 0.03));
  }
  function decay() {
    timer = 0;
    energy = Math.max(0, energy - 0.08);
    paint();
    if (energy > 0) timer = window.setTimeout(decay, 400);
  }
  function add(n: number) {
    if (motion.matches || document.hidden) return;
    energy = Math.min(2, energy + n);
    if (!timer) timer = window.setTimeout(decay, 400);
  }
  function sync() {
    clearTimeout(timer);
    timer = 0;
    if (motion.matches) { energy = 0; paint(); }
    if (!document.hidden && energy > 0) timer = window.setTimeout(decay, 400);
  }
  function page() {
    anchor = Math.min(5, Math.max(0, Number(root.dataset.emo ?? 1)));
    energy = 0;
    current = -1;
    sync();
    paint();
  }

  window.addEventListener('pointermove', () => {
    const now = performance.now();
    if (now - lastMove > 150) { lastMove = now; add(0.06); }
  }, { passive: true });
  window.addEventListener('pointerdown', () => add(0.3), { passive: true });
  document.addEventListener('pointerover', e => {
    const target = (e.target as Element)?.closest('a, button');
    if (target && (!(e.relatedTarget instanceof Node) || !target.contains(e.relatedTarget))) add(0.15);
  });
  document.addEventListener('visibilitychange', sync);
  motion.addEventListener('change', sync);
  document.addEventListener('astro:after-swap', page);
  page();
</script>

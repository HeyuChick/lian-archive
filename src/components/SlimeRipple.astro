---
// 史莱姆涟漪：指针按下时扩散的黏液波纹（零依赖，尊重减少动态偏好）
// 颜色接入情绪显色系统：跟随 --goo-color 漂移
---
<script>
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.addEventListener('pointerdown', (e) => {
    if (motion.matches) return;
    const ripple = document.createElement('span');
    ripple.className = 'slime-ripple';
    ripple.style.left = `${e.clientX}px`;
    ripple.style.top = `${e.clientY}px`;
    document.body.appendChild(ripple);
    ripple.addEventListener('animationend', () => ripple.remove(), { once: true });
    ripple.addEventListener('animationcancel', () => ripple.remove(), { once: true });
  }, { passive: true });
</script>
<style>
  :global(.slime-ripple) {
    position: fixed;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgb(var(--goo-color, 148, 234, 212));
    opacity: 0.35;
    filter: blur(1px);
    pointer-events: none;
    transform: translate(-50%, -50%) scale(1);
    animation: slime-spread 0.9s ease-out forwards;
    z-index: 9999;
    transition: background-color .8s ease;
  }
  @keyframes slime-spread {
    to {
      transform: translate(-50%, -50%) scale(14);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.slime-ripple) { display: none; }
  }
</style>

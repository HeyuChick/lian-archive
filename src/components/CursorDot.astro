---
// 悬浮光标：三形态——圆点（默认）/ 放大（可交互）/ 竖线（文本）
// 颜色随情绪显色漂移；系统光标全程禁用；仅精确指针设备启用
---
<div class="cursor-dot" id="cursorDot" aria-hidden="true"></div>

<script>
  (function initCursor() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!window.matchMedia('(pointer: fine)').matches) return;

    const dot = document.getElementById('cursorDot');
    if (!dot) return;
    document.body.classList.add('has-cursor');

    let cx = -100, cy = -100, tx = -100, ty = -100, shown = false;

    window.addEventListener('pointermove', (e) => {
      tx = e.clientX;
      ty = e.clientY;
      if (!shown) {
        shown = true;
        dot.classList.add('visible');
      }
    });

    document.addEventListener('pointerleave', () => {
      shown = false;
      dot.classList.remove('visible');
    });

    document.addEventListener('mouseover', (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;

      /* 优先级：可交互 > 文本 > 默认 */
      const interactive = t.closest('a, button, input, textarea, select, [role="button"]');
      const textZone = t.closest(
        '.prose, p, h1, h2, h3, h4, h5, h6, li, blockquote, code, pre, time'
      );

      dot.classList.toggle('hovering', !!interactive);
      dot.classList.toggle('text', !interactive && !!textZone);
    });

    (function follow() {
      cx += (tx - cx) * 0.18;
      cy += (ty - cy) * 0.18;
      dot.style.transform = `translate(${cx}px, ${cy}px)`;
      requestAnimationFrame(follow);
    })();
  })();
</script>

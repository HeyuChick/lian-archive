---
// CursorDot —— 自定义光标
// transition:persist：客户端路由切换页面时元素原样保留，不销毁不重建，
// 位置与事件监听天然连续，从根本上消除跨页面光标跳动。
---
<div class="cursor-dot" transition:persist></div>

<script>
  const INTERACTIVE_SELECTOR = 'a, button, [data-cursor="hover"]';
  const TEXT_SELECTOR = 'p, h1, h2, h3, h4, h5, h6, span, li, time, blockquote, td, th, figcaption';

  function initCursor(): void {
    // 触摸设备 / 减弱动画：不激活（has-cursor 不加，系统光标保留）
    if (window.matchMedia('(pointer: coarse)').matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const cursor = document.querySelector<HTMLElement>('.cursor-dot');
    if (!cursor) return;
    // 持久化元素跨页面存活，脚本只初始化一次
    if (cursor.dataset.ready) return;
    cursor.dataset.ready = '1';

    // NaN 标记“尚未初始化”，首次移动直接吸附而非从原点缓动
    let x = NaN;
    let y = NaN;
    let lastX = 0;
    let lastY = 0;

    document.addEventListener('mousemove', (e) => {
      lastX = e.clientX;
      lastY = e.clientY;
      if (Number.isNaN(x)) {
        x = lastX;
        y = lastY;
      }
      if (!cursor.classList.contains('visible')) cursor.classList.add('visible');

      const target = e.target as Element | null;
      const isInteractive = !!target?.closest?.(INTERACTIVE_SELECTOR);
      const isText = !isInteractive && !!target?.closest?.(TEXT_SELECTOR);
      cursor.classList.toggle('hovering', isInteractive);
      cursor.classList.toggle('text', isText);
    });

    // lerp 缓动跟随（每帧写入，代价仅一次 transform 更新）
    const loop = () => {
      if (!Number.isNaN(x)) {
        x += (lastX - x) * 0.2;
        y += (lastY - y) * 0.2;
        cursor.style.transform = `translate(${x}px, ${y}px)`;
      }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }

  function boot(): void {
    initCursor();
    // body 在导航后会被替换，交换完成后立刻重新打上 has-cursor，避免系统光标闪现
    document.body.classList.add('has-cursor');
  }

  boot();
  document.addEventListener('astro:after-swap', boot);
  document.addEventListener('astro:page-load', boot);
</script>

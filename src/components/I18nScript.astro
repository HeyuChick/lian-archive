---
// I18nScript —— 客户端 i18n 共享组件
// 读取 localStorage 持久化语言选择，全站 UI 即时切换。
// 事件委托实现，按钮替换/脚本延迟均不影响；导航后自动重跑。
// 主站（heyuchick.github.io）只需在布局中放入 <I18nScript /> 即可复用。
---
<script>
  import { ui } from '../i18n/ui';

  const HTML_LANG: Record<string, string> = { zh: 'zh-CN', en: 'en', ja: 'ja' };

  // 当前语言：不在脚本作用域缓存，从 localStorage 读 —— 跨导航保持同步
  function currentLang(): string {
    const saved = localStorage.getItem('lian-lang');
    if (saved && ui[saved as keyof typeof ui]) return saved;
    const nav = (navigator.language || '').toLowerCase();
    if (nav.startsWith('ja')) return 'ja';
    if (nav.startsWith('en')) return 'en';
    return 'zh';
  }

  function apply(lang: string): void {
    const dict = (ui as Record<string, Record<string, string>>)[lang];
    if (!dict) return;
    localStorage.setItem('lian-lang', lang);
    document.documentElement.lang = HTML_LANG[lang] || lang;
    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (key && dict[key] !== undefined) el.textContent = dict[key];
    });
    syncButtons(lang);
  }

  // 只同步按钮高亮（读取当前语言，不重新替换文本）
  function syncButtons(lang?: string): void {
    const active = lang ?? currentLang();
    document.querySelectorAll<HTMLElement>('.lang-btn').forEach((b) => {
      b.classList.toggle('is-active', b.getAttribute('data-lang') === active);
    });
  }

  // 事件委托：一次绑定，永久有效；按钮被替换也不丢
  if (!(window as any).__i18nDelegated) {
    (window as any).__i18nDelegated = true;
    document.addEventListener('click', (e) => {
      const btn = (e.target as Element | null)?.closest?.('.lang-btn');
      if (!btn) return;
      const lang = btn.getAttribute('data-lang');
      if (lang) apply(lang);
    });
  }

  function boot(): void {
    syncButtons();
    // 新页面首绘即替换为持久化语言文本
    const saved = localStorage.getItem('lian-lang');
    if (saved) apply(saved);
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
